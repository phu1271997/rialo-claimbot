# ─────────── Deploy / Contracts ───────────
DEPLOYER_PRIVATE_KEY=0x...
ORACLE_ADDRESS=0x...                      # Address the backend signs verdicts with
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# Optional overrides
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# CLAIM_DEADLINE_SECONDS=172800           # Set to 300 for a fast deadline-refund demo
# FUNCTIONS_SUBSCRIPTION_ID=3521          # Needed only for VehicleVerifier

# ─────────── Backend (backend/.env) ───────────
PORT=4000
LOG_LEVEL=info
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL_FALLBACK=https://sepolia.infura.io/v3/YOUR_KEY
ORACLE_PRIVATE_KEY=0x...                  # Private key for ORACLE_ADDRESS above
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
PINATA_JWT=eyJhbGc...
PINATA_GATEWAY=https://gateway.pinata.cloud
OPENWEATHER_KEY=...
ADMIN_API_KEY=choose-a-long-random-string # Gates POST /admin/retry/:claimId
# MOCK_AI=true                            # Run the pipeline with no Anthropic key (tests + demo fallback)
# CLAIM_REGISTRY_ADDRESS=0x...            # Overrides contracts/deployments/sepolia.json
# POLICY_MANAGER_ADDRESS=0x...

# ─────────── Frontend (frontend/.env.local) ───────────
NEXT_PUBLIC_WC_PROJECT_ID=...             # cloud.walletconnect.com
NEXT_PUBLIC_ALCHEMY_KEY=...
NEXT_PUBLIC_POLICY_MANAGER=0x...
NEXT_PUBLIC_CLAIM_REGISTRY=0x...
NEXT_PUBLIC_PAYOUT_VAULT=0x...
NEXT_PUBLIC_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_JWT=eyJhbGc...                     # Server-only, used by /api/upload
